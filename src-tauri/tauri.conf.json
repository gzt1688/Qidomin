{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qidomin",
  "version": "1.4.0",
  "identifier": "com.qidomin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Qidomin 设置",
        "label": "main",
        "width": 760,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "create": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
